        "role": "소규모 팀",
        "situation": "git/GitHub 기반 공유와 자동 동기화"
      }
    ],
    "start": [
      {
        "command": false,
        "text": "npm install -g @inkeep/open-knowledge   # Node.js 24+ 와 git 필요"
